<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_light_rounded" android:elevation="10dp" android:outlineSpotShadowColor="#22000000" android:outlineAmbientShadowColor="#11000000"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:padding="16dp"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        
        <TextView
            android:id="@+id/taskTime"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_width="60dp"
            android:layout_height="wrap_content" />
            
        <View
            android:id="@+id/taskBar"
            android:background="@drawable/bg_gradient_primary_rounded"  android:outlineSpotShadowColor="@color/purple_primary_end" android:outlineAmbientShadowColor="@color/purple_primary_start"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp" />
            
        <TextView
            android:id="@+id/taskTitle"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold" />

        
            <ImageView android:id="@+id/btnExpand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/arrow_down_float"
            android:padding="4dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Hidden Action Menu -->
    <LinearLayout
        android:id="@+id/actionMenu"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="4">
        
        <TextView
            android:id="@+id/btnMenuDelete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Delete"
            android:textColor="#F44336"
            android:textStyle="bold"
            android:textSize="12sp" />
            
        <TextView
            android:id="@+id/btnMenuDone"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Done"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnMenuEdit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Edit"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:textSize="12sp" />
            
        <TextView
            android:id="@+id/btnMenuStart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Start"
            android:background="@drawable/bg_pill_white"
            android:backgroundTint="@color/accent_blue"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
