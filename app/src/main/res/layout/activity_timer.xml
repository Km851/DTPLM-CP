<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timerRoot"
    android:background="@drawable/bg_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Time display (matches home screen) -->
    <TextClock
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="start|center"
        android:id="@+id/timerTimeClock"
        android:layout_width="wrap_content"
        android:layout_height="31dp"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-light"
        android:layout_marginStart="20dp"
        android:format12Hour="h:mm a"
        android:format24Hour="h:mm a"
        android:letterSpacing="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextClock
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="start|center"
        android:id="@+id/timerDayClock"
        android:layout_width="wrap_content"
        android:layout_height="31dp"
        android:fontFamily="sans-serif-light"
        android:layout_marginStart="10dp"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:letterSpacing="0.05"
        app:layout_constraintBaseline_toBaselineOf="@id/timerTimeClock"
        app:layout_constraintStart_toEndOf="@id/timerTimeClock" />

    <!-- Profile photo (matches home screen) -->
    <androidx.cardview.widget.CardView
        app:cardElevation="0dp"
        android:outlineSpotShadowColor="#1A000000"
        android:id="@+id/timerProfileCard"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/timerProfileImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <!-- Coming up section — positioned above timer, below header -->
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/nextUpPreviewTimer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/timerTimeClock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coming up"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:ellipsize="end"
            android:id="@+id/nextUpTask1Timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:drawableStart="@android:drawable/presence_invisible" />

        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:ellipsize="end"
            android:id="@+id/nextUpTask2Timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:drawableStart="@android:drawable/presence_invisible" />
    </LinearLayout>

    <!-- Task name — above timer -->
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/timerTaskNameTimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/timerContainerTimer" />

    <!-- Circular timer — centered in the remaining space below nextUpPreview -->
    <FrameLayout
        android:id="@+id/timerContainerTimer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nextUpPreviewTimer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/timerProgressTimer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/circular_timer"
            android:rotation="-90"
            style="?android:progressBarStyleHorizontal" />

        <TextView
            android:textSize="36sp"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:id="@+id/timerTextTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45:00"
            android:fontFamily="sans-serif-light" />
    </FrameLayout>

    <!-- Button row — below timer -->
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/timerButtonRowTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timerContainerTimer">

        <androidx.cardview.widget.CardView
            app:cardElevation="0dp"
            android:outlineSpotShadowColor="#1A000000"
            android:id="@+id/btnCompleteTaskTimer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/purple_primary_start"
            app:cardCornerRadius="20dp">

            <TextView
                android:textSize="13sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Complete ✅"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="22dp"
                android:paddingEnd="22dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            app:cardElevation="0dp"
            android:outlineSpotShadowColor="#1A000000"
            android:id="@+id/btnSaveQuitTimer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/text_secondary"
            app:cardCornerRadius="20dp">

            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Save &amp; Quit"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="22dp"
                android:paddingEnd="22dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
